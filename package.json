{
  "name": "ziwani-smart-waste",
  "version": "1.0.0",
  "description": "Smart waste management app for Taka Rangers in Kisumu",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "react-scripts": "5.0.1",
    "axios": "^1.4.0",
    "date-fns": "^2.30.0"
  },
